{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lc/schema": ["packages/schema/src/index.ts"],
      "@lc/sim-core": ["packages/sim-core/src/index.ts"],
      "@lc/compiler": ["packages/compiler/src/index.ts"],
      "@lc/content": ["packages/content/src/index.ts"],
      "@lc/opt-solver": ["tools/opt-solver/src/index.ts"],
      "@lc/level-editor": ["tools/level-editor/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tools/*/src/**/*.ts",
    "tools/*/test/**/*.ts",
    "vitest.config.ts"
  ]
}
